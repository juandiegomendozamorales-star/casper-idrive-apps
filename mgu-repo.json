{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "icon": "icon.png",
    "mguHmi": [
      "ID8"
    ],
    "build": {
      "python": "kit/tools/build.py",
      "args": [
        "{id}"
      ],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}.tgz",
      "shared": [
        "kit/runtime",
        "kit/platform",
        "kit/localization",
        "kit/tools/build.py",
        "kit/tools/pack_data.py",
        "kit/tools/localize.py",
        "kit/tools/locale-revisions.json",
        "kit/tools/make_icon.js",
        "kit/tools/oapgen",
        "oap-sdk"
      ]
    }
  },
  "tools": [
    {
      "id": "idrive7-renderd",
      "path": "tools/idrive7-renderd",
      "title": "GPU renderer",
      "mguHmi": [
        "ID7",
        "ID8"
      ]
    },
    {
      "id": "mgu-inputgate",
      "path": "tools/mgu-inputgate",
      "title": "Controller gate",
      "needs": [
        "renderer"
      ],
      "optional": false,
      "uninstallable": true,
      "mguHmi": [
        "ID7",
        "ID8"
      ]
    }
  ]
}